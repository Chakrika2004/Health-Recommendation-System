    "import joblib\n",
    "\n",
    "# Load your existing model\n",
    "import pickle\n",
    "with open(\"health_model.pkl\", \"rb\") as f:\n",
    "    model = pickle.load(f)\n",
    "\n",
    "# Save a compressed version\n",
    "joblib.dump(model, \"health_model_compressed.pkl\", compress=3)\n"
   ]
